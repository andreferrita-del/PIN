
#!/usr/bin/env bash
set -e

PACKAGE="PIN"
VERSION="0.6"

PREFIX="/usr/local"
BINDIR=""
CXX="${CXX:-}"

for arg in "$@"; do
    case "$arg" in
        --prefix=*) PREFIX="${arg#*=}" ;;
        --bindir=*) BINDIR="${arg#*=}" ;;
        --help)
            echo "Usage: ./configure [OPTIONS]"
            echo "  --prefix=PATH   Installation prefix"
            echo "  --bindir=PATH   Executable directory"
            echo "  CXX=COMPILER    C++ compiler"
            exit 0
            ;;
        *)
            echo "Unknown option: $arg"
            exit 1
            ;;
    esac
done

BINDIR="${BINDIR:-$PREFIX/bin}"

echo "Configuring $PACKAGE $VERSION..."

# Detect compiler
if [ -z "$CXX" ]; then
    if command -v clang++ >/dev/null 2>&1; then
        CXX=clang++
    elif command -v g++ >/dev/null 2>&1; then
        CXX=g++
    else
        echo "Error: No C++ compiler found."
        exit 1
    fi
fi

echo "Checking compiler: $CXX"

# Check C++17
TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT

cat > "$TMP/test.cpp" <<'CPP'
#include <iostream>
int main() { return 0; }
CPP

if ! $CXX -std=c++17 "$TMP/test.cpp" -o "$TMP/test" 2>/dev/null; then
    echo "Error: C++17 is not supported."
    exit 1
fi

# Check source files
SOURCES="
src/main.cpp
src/lexer/token.cpp
src/lexer/lexer.cpp
src/parser/parser.cpp
src/runtime/runtime.cpp
"

for source in $SOURCES; do
    if [ ! -f "$source" ]; then
        echo "Error: Missing source: $source"
        exit 1
    fi
done

if [ ! -d include ]; then
    echo "Error: include directory not found."
    exit 1
fi

# Generate Makefile
cat > Makefile <<EOF
CXX = $CXX
CXXFLAGS = -std=c++17 -O2 -Wall -Wextra
CPPFLAGS = -Iinclude

PREFIX = $PREFIX
BINDIR = $BINDIR

TARGET = build/host/pin

SOURCES = $SOURCES

.PHONY: all clean install uninstall

all: \$(TARGET)

\$(TARGET): \$(SOURCES)
	@mkdir -p build/host
	\$(CXX) \$(CPPFLAGS) \$(CXXFLAGS) \$(SOURCES) -o \$(TARGET)

install: all
	@mkdir -p "\$(DESTDIR)\$(BINDIR)"
	install -m 755 \$(TARGET) "\$(DESTDIR)\$(BINDIR)/pin"

uninstall:
	rm -f "\$(DESTDIR)\$(BINDIR)/pin"

clean:
	rm -rf build
EOF

echo ""
echo "Configuration successful!"
echo "Compiler: $CXX"
echo "C++ standard: C++17"
echo "Prefix: $PREFIX"
echo "Binary: $BINDIR/pin"
echo ""
echo "Now run:"
echo "  make"
echo "  make install"
